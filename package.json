{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/utils",
  "version": "2.3.0",
  "description": "Shared TypeScript utilities for removing repeated code across Sovereignbase codebases.",
  "keywords": [
    "typescript",
    "sovereignbase",
    "utilities"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:browsers && npm run test:e2e:runtimes",
    "test:e2e:browsers": "node test/e2e/runsInBrowsers/run.mjs",
    "test:e2e:runtimes": "npm run test:e2e:node && npm run test:e2e:bun && npm run test:e2e:deno && npm run test:e2e:edge && npm run test:e2e:cloudflare",
    "test:e2e:node": "node test/e2e/runsInNode/run.mjs",
    "test:e2e:bun": "node test/e2e/runsInBun/run.mjs",
    "test:e2e:deno": "node test/e2e/runsInDeno/run.mjs",
    "test:e2e:edge": "node test/e2e/runsInEdgeRuntimes/run.mjs",
    "test:e2e:cloudflare": "vitest run --config test/e2e/runsInCloudflareWorkers/vitest.config.ts",
    "bench": "npm run build && node benchmark/bench.js",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "edge-runtime": "^4.0.1",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/utils.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/utils/issues"
  },
  "homepage": "https://github.com/sovereignbase/utils#readme"
}
